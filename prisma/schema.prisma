// Prisma schema for Black Orchid luxury restaurant + CMS (Supabase PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN") // ADMIN | MANAGER | EDITOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  order     Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id              String       @id @default(cuid())
  name            String
  tagline         String?
  description     String       @db.Text
  shortDescription String?
  price           Float?
  variants        String       @default("[]") @db.Text // JSON string of DishVariant[]
  image           String?
  images          String       @default("[]") @db.Text // JSON array of URLs
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  available       Boolean      @default(true)
  veg             Boolean      @default(false)
  dietaryType     String       @default("not_specified") // vegetarian | non_vegetarian | not_specified
  spice           Int          @default(0) // 0-3
  featured        Boolean      @default(false)
  chefRecommended Boolean      @default(false)
  ingredients     String       @default("[]") @db.Text // JSON array of strings
  allergens       String       @default("[]") @db.Text // JSON array of strings
  servingSize     String?
  winePairing     String?
  tastingNotes    String?      @db.Text
  pairingPrice    Float?
  order           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String
  url       String
  caption   String?  @db.Text
  category  String   @default("Interior") // Food | Drinks | Interior | Events | Banquet
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id            String   @id @default(cuid())
  name          String
  phone         String
  phoneNormalized String?
  email         String
  date          String
  time          String
  guests        Int
  kids          Int      @default(0)
  special       String?  @db.Text
  status        String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationLog {
  id               String    @id @default(cuid())
  reservationId    String
  notificationType String    // EMAIL | SMS
  recipient        String
  status           String    // PENDING | SENT | FAILED
  provider         String?   // SMTP | TWILIO | FAST2SMS | LOG
  error            String?   @db.Text
  retryCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastAttemptAt    DateTime?

  @@unique([reservationId, notificationType])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  photo     String?
  rating    Int      @default(5)
  message   String   @db.Text
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventItem {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  date        String
  image       String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CateringPackage {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  price       Float
  image       String?
  guests      String
  features    String   @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id                  String   @id @default("singleton")
  restaurantName       String   @default("Black Orchid")
  tagline             String   @default("Fine Dining & Banquet")
  heroTitle           String   @default("An Exquisite Symphony of Flavour")
  heroSubtitle        String   @default("Where culinary artistry meets timeless elegance")
  aboutTitle          String   @default("Our Story")
  aboutBody           String   @db.Text
  phone               String   @default("+91 95850 18502")
  phoneSecondary       String?  @default("+91 91764 77647")
  email               String   @default("boan.reservations@gmail.com")
  managerEmail        String   @default("boan.reservations@gmail.com")
  smsSenderName       String   @default("Black Orchid Anna Nagar")
  notificationsEnabled Boolean  @default(true)
  address             String   @default("G Block, L33, 1st Avenue, R.V. Nagar, Brindhavan Colony, VOC Nagar, Anna Nagar East, Chennai, Tamil Nadu – 600102")
  mapEmbed            String?  @db.Text
  hoursWeekday        String   @default("11:00 AM – 11:00 PM")
  hoursWeekend        String   @default("11:00 AM – 11:00 PM")
  instagram           String   @default("https://www.instagram.com/blackorchid_annanagar/?hl=en")
  facebook            String   @default("https://www.facebook.com/blackorchidchennai/")
  twitter             String   @default("")
  whatsapp            String   @default("+919585018502")
  banquetCapacity     String   @default("Up to 300 guests")
  banquetDesc         String   @db.Text
  metaTitle           String   @default("Black Orchid — Restobar & Fine Dining | Anna Nagar East, Chennai")
  metaDesc            String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
